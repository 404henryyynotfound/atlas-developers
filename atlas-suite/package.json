{
  "name": "atlas-suite",
  "version": "1.0.0",
  "private": true,
  "description": "One GUI for the Atlas Financial app family",
  "main": "main.js",
  "author": {
    "name": "Atlas Financial",
    "email": "support@atlas-financial.surge.sh"
  },
  "homepage": "https://atlas-financial.surge.sh",
  "license": "MIT",
  "scripts": {
    "bundle:web": "node scripts/bundle-apps.mjs",
    "start": "npm run bundle:web && electron .",
    "dist:linux-x64": "npm run bundle:web && electron-builder --linux --x64",
    "dist:linux-arm64": "npm run bundle:web && electron-builder --linux --arm64 -c electron-builder.arm64.yml",
    "dist:mac-x64": "npm run bundle:web && electron-builder --mac --x64",
    "dist:mac-arm64": "npm run bundle:web && electron-builder --mac --arm64",
    "dist:win-x64": "npm run bundle:web && electron-builder --win --x64",
    "dist:win-arm64": "npm run bundle:web && electron-builder --win --arm64"
  },
  "devDependencies": {
    "electron": "^28.3.0",
    "electron-builder": "^24.13.3"
  }
}
