{
  "name": "atlas-developers-gui",
  "version": "1.0.0",
  "description": "Atlas Developers desktop shell for the local-first dashboard.",
  "main": "main.js",
  "private": true,
  "author": "Atlas Developers",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux:x64": "electron-builder --linux --x64 --publish never",
    "dist:linux:arm64": "electron-builder --linux --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:win:x64": "electron-builder --win --x64 --publish never",
    "dist:win:arm64": "electron-builder --win --arm64 --publish never",
    "bundle:web": "node -e \"require('fs').cpSync('../web','web-build',{recursive:true})\""
  },
  "devDependencies": {
    "electron": "^28.3.0",
    "electron-builder": "^24.13.3"
  }
}
